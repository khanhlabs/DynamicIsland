{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Island",
  "version": "0.2.1",
  "identifier": "com.dynamicisland.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dynamic Island",
        "width": 328,
        "height": 56,
        "minWidth": 300,
        "minHeight": 52,
        "maxWidth": 700,
        "maxHeight": 680,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RDQ2MTlGOENDNjBDNzgKUldSNERNYU1uMkhVcDlQKzN2c2hobEhnNUNPelN1dkp1bno2U2l1eENiTDFuWEdETmNQQzdNa3IK",
      "endpoints": [
        "https://github.com/khanhlabs/DynamicIsland/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
